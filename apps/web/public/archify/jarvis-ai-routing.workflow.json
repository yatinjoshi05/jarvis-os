  "groups": [
    { "id": "policy_group", "label": "Behavior Policy Synthesis", "lane": "policy", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "cascade_group", "label": "Multi-Provider Cascade", "lane": "models", "fromCol": 3, "toCol": 4, "variant": "security" },
    { "id": "output_group", "label": "Completion Output", "lane": "output", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["user_req", "intent_classifier", "personality_builder", "nvidia_primary", "response_finalizer"],
  "nodes": [
    { "id": "user_req", "lane": "intake", "col": 0, "type": "external", "label": "User Query", "sublabel": "Prompt / Conversation", "width": 136 },
    { "id": "intent_classifier", "lane": "policy", "col": 1, "type": "backend", "label": "BehaviorEngine", "sublabel": "createPolicy(intent)", "tag": "confidence score", "width": 136 },
    { "id": "personality_builder", "lane": "policy", "col": 2, "type": "backend", "label": "applyPersonality", "sublabel": "System Prompt Injection", "tag": "voice/tone lock", "width": 136 },
    { "id": "nvidia_primary", "lane": "models", "col": 3, "type": "cloud", "label": "NVIDIA NIM", "sublabel": "Llama 3.1 70B Instruct", "tag": "preferredProvider", "width": 136 },
    { "id": "gemini_fallback", "lane": "models", "col": 4, "type": "cloud", "label": "Google Gemini", "sublabel": "gemini-1.5-flash", "tag": "auto-fallback", "width": 136 },
    { "id": "error_handler", "lane": "policy", "col": 5, "type": "security", "label": "Cascade Failure", "sublabel": "All Providers Failed", "tag": "HTTP 502 / Throw", "width": 136 },
    { "id": "response_finalizer", "lane": "output", "col": 5, "type": "frontend", "label": "finalizeText", "sublabel": "Emit Clean Output", "tag": "metadata tagged", "width": 136 }
  ],
  "edges": [
    { "id": "req-to-classifier", "from": "user_req", "to": "intent_classifier", "label": "dispatch query", "variant": "default" },
