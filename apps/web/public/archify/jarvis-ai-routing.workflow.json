    { "id": "builder-to-nvidia", "from": "personality_builder", "to": "nvidia_primary", "label": "try NVIDIA", "variant": "emphasis" },
    { "id": "nvidia-success", "from": "nvidia_primary", "to": "response_finalizer", "label": "200 completion", "variant": "emphasis" },
    { "id": "nvidia-fail", "from": "nvidia_primary", "to": "gemini_fallback", "label": "NVIDIA timeout/error", "variant": "security", "role": "branch" },
    { "id": "gemini-success", "from": "gemini_fallback", "to": "response_finalizer", "label": "Gemini 200 OK", "variant": "default" },
    { "id": "gemini-fail", "from": "gemini_fallback", "to": "error_handler", "label": "Gemini error", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Behavior Policy & Personality",
      "items": [
        "BehaviorEngine analyzes user intent and assigns confidence metrics",
        "System prompt dynamically combines personality presets and intent constraints",
        "Source messages normalized into standard roles (user, model, system)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Config Fallback Cascade",
      "items": [
        "Prefers NVIDIA NIM Llama 3.1 70B hosted on integrate.api.nvidia.com",
        "Automatically falls back to Google Gemini 1.5 Flash upon HTTP error or timeout",
        "Continues down cascade to secondary provider keys if configured in environment"
      ]
    },
    {
      "dot": "rose",
      "title": "Output Finalization & Resiliency",
      "items": [
        "Successful completions pass through finalizeText for policy compliance",
        "Returns verified metadata including provider name, intent, and confidence score",
        "Gracefully returns HTTP 502 with descriptive diagnostics if all providers fail"
      ]
    }
  ]
}
