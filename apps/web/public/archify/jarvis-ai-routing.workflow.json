  "phases": [
    { "id": "classification", "label": "Intent & Policy", "fromCol": 0, "toCol": 1 },
    { "id": "prompt_assembly", "label": "Prompt Formulation", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "provider_inference", "label": "Cascade Execution", "fromCol": 3, "toCol": 4, "variant": "security" },
    { "id": "response_delivery", "label": "Delivery / Error", "fromCol": 5, "toCol": 5, "variant": "dashed" }
