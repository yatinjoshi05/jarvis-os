{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JARVIS OS",
  "version": "1.0.0",
  "identifier": "com.jarvis.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JARVIS OS",
        "url": "/",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "title": "JARVIS OS - Initializing",
        "url": "/splashscreen.html",
        "width": 500,
        "height": 450,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "compression": "lzma",
        "startMenuFolder": "JARVIS OS",
        "installerHooks": "hooks.nsi"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
