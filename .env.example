# ==============================================================================
# JARVIS OS — Environment Configuration Template
# All values are safe non-sensitive placeholders.
# ==============================================================================

# Backend Server Configuration
PORT=3001

# AI Completion Providers (Server Proxy)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_for_embeddings_here
CLOUDFLARE_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/your_account/your_gateway
CLOUDFLARE_GATEWAY_TOKEN=your_cloudflare_gateway_token_here

# Voice Synthesis (Server Proxy)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
VITE_ELEVENLABS_MODEL=eleven_multilingual_v2

# Google OAuth & YouTube Studio Module (Planned)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/ytstudio/channels/oauth/callback

# Frontend Client Configuration (Vite)
VITE_BACKEND_API_URL=http://localhost:3001
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Business Integration Placeholders (Optional Modules)
