  "nodes": [
    { "id": "conv_turn", "type": "frontend", "label": "Conversation Turn", "sublabel": "Dialogue Stream", "stage": 0, "row": 0, "tag": "tokens" },
    { "id": "explicit_fact", "type": "frontend", "label": "Explicit Fact", "sublabel": "Direct Memory", "stage": 0, "row": 2, "tag": "facts" },
    { "id": "auto_memory", "type": "backend", "label": "AutoMemoryEngine", "sublabel": "Auto Extractor", "stage": 1, "row": 0, "tag": "extractor" },
    { "id": "embedding_svc", "type": "backend", "label": "EmbeddingService", "sublabel": "Vector Transform", "stage": 2, "row": 0, "tag": "vectors" },
    { "id": "graph_extractor", "type": "backend", "label": "Graph Extractor", "sublabel": "Entity Relations", "stage": 2, "row": 2, "tag": "triplets" },
    { "id": "vector_store", "type": "database", "label": "VectorStore", "sublabel": "vectors.json Store", "stage": 3, "row": 0, "tag": "cosine index" },
    { "id": "knowledge_graph", "type": "database", "label": "KnowledgeGraph", "sublabel": "graph.json Store", "stage": 3, "row": 2, "tag": "graph index" },
    { "id": "hybrid_retriever", "type": "backend", "label": "MemoryIntelligence", "sublabel": "Hybrid Recall", "stage": 4, "row": 0, "tag": "hybrid rank" },
    { "id": "context_engine", "type": "backend", "label": "ContextEngine", "sublabel": "Prompt Augment", "stage": 4, "row": 2, "tag": "LLM window" }
  ],
  "flows": [
    { "id": "conv-to-auto", "from": "conv_turn", "to": "auto_memory", "label": "dialogue stream", "classification": "message tokens", "variant": "emphasis", "route": "straight" },
    { "id": "fact-to-graph", "from": "explicit_fact", "to": "graph_extractor", "label": "manual entity facts", "classification": "user explicit", "variant": "default", "route": "straight" },
    { "id": "auto-to-embed", "from": "auto_memory", "to": "embedding_svc", "label": "salient text", "classification": "text payload", "variant": "emphasis", "route": "straight" },
    { "id": "auto-to-graph", "from": "auto_memory", "to": "graph_extractor", "label": "entity extraction", "classification": "entity relations", "variant": "default" },
    { "id": "embed-to-vectors", "from": "embedding_svc", "to": "vector_store", "label": "upsert embedding", "classification": "vector array", "variant": "emphasis", "route": "straight" },
    { "id": "graph-to-store", "from": "graph_extractor", "to": "knowledge_graph", "label": "upsert graph nodes", "classification": "graph schema", "variant": "default", "route": "straight" },
    { "id": "vectors-to-hybrid", "from": "vector_store", "to": "hybrid_retriever", "label": "semantic similarity", "classification": "top-k matches", "variant": "emphasis", "route": "straight", "labelAt": [790, 108] },
    { "id": "graph-to-hybrid", "from": "knowledge_graph", "to": "hybrid_retriever", "label": "related entities", "classification": "graph traversal", "variant": "default" },
    { "id": "hybrid-to-context", "from": "hybrid_retriever", "to": "context_engine", "label": "ranked memory", "classification": "injected prompt", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Dual-Store Semantic Pipeline",
      "items": [
        "AutoMemoryEngine scores conversational turns and auto-extracts memories above threshold 0.45",
        "Dense vectors stored locally in vectors.json with fast cosine similarity scoring",
        "KnowledgeGraph tracks entity nodes and relationship edges in knowledge-graph.json"
      ]
    },
    {
      "dot": "amber",
      "title": "Local Persistence",
      "items": [
        "Embeddings and relations stored in JSON files under services/backend/data",
        "Zero external cloud database requirement protects personal data privacy",
        "58 automated unit tests verify scoring, embedding, and retrieval algorithms"
      ]
    },
    {
      "dot": "violet",
      "title": "Hybrid Context Injection",
      "items": [
        "MemoryIntelligenceService combines vector cosine distance, recency weight, and graph hops",
        "Top-ranked associative memories injected into ContextEngine for personalized LLM inference",
        "Maintains context continuity across separate desktop workspace sessions"
      ]
    }
  ]
}
